# =============================================================================
# Copy this file to .env.local and fill it in. NEVER commit .env.local.
# .gitignore already excludes it.
#
# Nobody but you should ever type these values — not a developer, not a chat
# assistant, not a support agent. Get them yourself from the Viva banking app.
# =============================================================================

# --- WHICH VIVA ENVIRONMENT --------------------------------------------------
# "demo" (default, sandbox, nothing is ever charged) or "production" (REAL MONEY).
# Anything other than exactly "production" is treated as demo. Leave it as demo
# until the go-live checklist in PAYMENTS.md is fully done.
VIVA_ENV=demo

# --- SMART CHECKOUT CREDENTIALS ---------------------------------------------
# Viva banking app → Settings → API access → Smart Checkout credentials.
# Demo credentials come from demo.vivapayments.com, live from www.vivapayments.com.
# They are NOT interchangeable.
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=

# Payment source code. Viva banking app → Sales → Payment sources.
# Create a source of type "Website", set its Success and Failure URLs (see
# PAYMENTS.md), then paste its 4-digit code here. "Default" works in demo.
VIVA_SOURCE_CODE=Default

# --- MERCHANT CREDENTIALS (webhooks only) -----------------------------------
# Only needed so /api/webhook can answer Viva's verification handshake.
# Viva banking app → Settings → API access → Merchant ID and API key.
VIVA_MERCHANT_ID=
VIVA_API_KEY=

# --- OPTIONAL TWEAKS --------------------------------------------------------
# Seconds the customer has to complete payment before the order expires.
VIVA_PAYMENT_TIMEOUT=1800
# Accent colour of the Viva-hosted payment page, hex without the #.
VIVA_CHECKOUT_COLOR=00c566

# --- THIS SITE --------------------------------------------------------------
# Public origin, no trailing slash. Used to build the return URL.
# Vercel sets VERCEL_URL automatically, so you only need this for a custom domain.
PUBLIC_SITE_URL=http://localhost:5173

# Restrict which checkout options are offered. Omit for all four.
# ENABLED_FULFILMENT=delivery,pickup_paid,pickup_unpaid,cod

# --- ORDER STORAGE (optional but recommended for production) ---------------
# Without these, orders are held in memory and are lost when the serverless
# instance recycles. Viva's dashboard still has every payment, but the
# customer's confirmation page would 404. Add Upstash Redis via the Vercel
# marketplace and these two names get set for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- ORDER EMAILS (optional) ------------------------------------------------
# Without RESEND_API_KEY nothing is emailed and orders are logged only.
# For cash-on-delivery and reserve-in-shop this is the ONLY notification the
# shop gets, so set it before those go live.
RESEND_API_KEY=
SHOP_ORDER_EMAIL=info@fitnessmaniacs.com.cy
ORDER_FROM_EMAIL=orders@fitnessmaniacs.com.cy
